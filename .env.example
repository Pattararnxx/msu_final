# Copy to .env.local and fill in. .env.local is gitignored.
# Without this key /api/chat still answers, but from a canned offline template
# instead of the model. Get one at https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# Optional. Defaults to the current DeepSeek model used by the app.
DEEPSEEK_MODEL=deepseek-v4-flash

# Base URL used by scripts/chat.ts. Change only if the dev server runs elsewhere.
CHAT_BASE_URL=http://localhost:3000

# ThaiBankSlip integration is prepared but intentionally disabled for now.
# The API endpoint and payload are not wired until the provider contract is confirmed.
THAIBANKSLIP_DOCS_URL=https://thaibankslip.com/docs
THAIBANKSLIP_API_URL=
THAIBANKSLIP_API_KEY=
THAIBANKSLIP_ENABLED=false

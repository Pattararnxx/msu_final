# Copy to .env.local and fill in. .env.local is gitignored.
# Without this key /api/chat still answers, but from a canned offline template
# instead of the model. Get one at https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Required by the order upload panel OCR. Keys stay on the server.
TYPHOON_OCR_API_KEY=
TYPHOON_OCR_MODEL=typhoon-ocr
TYPHOON_NORMALIZER_MODEL=typhoon-v2.5-30b-a3b-instruct

# Base URL used by scripts/chat.ts. Change only if the dev server runs elsewhere.
CHAT_BASE_URL=http://localhost:3000
